module {
   dfschedule.host_0 {
      %gmem = "dfschedule.dfhost.config.alloc"() : () -> memref<1024xf32>
      %shim0 = dfschedule.dfhost.config.declaretile {col = 3, row = 0} : dfhost.config.tile
      %core0 = dfschedule.dfhost.config.declaretile {col = 0, row = 3} : dfhost.config.tile
      %core1 = dfschedule.dfhost.config.declaretile {col = 1, row = 3} : dfhost.config.tile
      %slice_0 = tensor.extract_slice  %data[...]
      %slice_1 = tensor.extract_slice  %data[...]
      %kernel_packet_0 = dfschedule.dfhost.packet @packet0 (%slice_0) {dma_channel=0}
      %kernel_packet_1 = dfschedule.dfhost.packet @packet1 (%slice_1) {dma_channel=0}
      %bd_config = "dfhost.config.dma_bd"(%gmem) {
        bd_id = 0 : i32,
        offset = 0 : i32,
        len = 1024 : i32,
        enable_packet = true,
        packet_id = 10 : i32,
        next_bd = -1 : i32
      } : (!dfhost.tile, memref<1024xf32>) -> !dfhost.bd_handle

      %io_0 = "dfhost.config.create_io"(%bd_config0, %shim0) {
        channel = 0 : i32,
        direction = "MM2S",
        operation = "SEND"
      } : ( !dfhost.bdconfig_handle) -> !dfhost.io_handle

      //launch kernel
      %evt_group = "ds.host.launch_kernel_group"(%core_0, %core_1) {
        callee = [@dskernel_receiver],
        distributed_args = [@packet0, @packet1],   
      } : (!ds.tile, !ds.tile, tensor<4xi32>, i32) -> !ds.event
      // ============================================================
      // Step 3: schedule
      // ============================================================
      %bd_id = dfhost.schedule.getbdid(): arith.constant(i32)
      %evnt_io = "dfhost.schedule.start_io"(%io_0, %bd_id) : (!dfhost.io_handle) -> ()
      dfhost.schedule.wait(%evt_io, %evt_kern)
    
  }
  dfschedule.dskernel_receiver(%arg0: packet,%loop_count:arith:constant) {
    %input_tensor = dfschedule.gettensor(%arg0)
    %channel = dfschedule.getdmachannel(%arg0)
    %ping = dfschedule.kernel.memalloc(%input_tensor) 
        : (tensor<16x256xf32>) -> memref<16x256xf32, "SHARED">
  
    %pong = dfschedule.kernel.memalloc(%input_tensor) 
        : (tensor<16x256xf32>) -> memref<16x256xf32, "SHARED">

    %0 = dskernel.lock_init(0, "ping_aquire_lock") -> !dskernel.lock
    %1 = dskernel.lock_init(0, "pong_aquire_lock") -> !dskernel.lock
    %2 = dskernel.lock_init(1, "ping_release_lock") -> !dskernel.lock
    %3 = dskernel.lock_init(0, "pong_release_lock") -> !dskernel.lock
    
    // --- Thread A (DMA): Runs in Parallel ---
    // (Your code was correct, but the initial lock values must 
    //  match the parallel compute loop's needs. 
    //  DMA waits for Ping-Release(1) and releases Ping-Acquire(0))
    "dskernel.launch_dma_s2m_loop"(%ping, %pong) {
      listen_on_packet_id = %pkt_id, // <--- 使用提取出的 ID
      
      // 告诉 DMA: 
      // 1. 获取 Write 锁 (确保 buffer 空闲)
      // 2. 搬运数据
      // 3. 释放 Read 锁 (告诉 Core 数据好了)
      locks_ping = { acq=%l_ping_write, rel=%l_ping_read },
      locks_pong = { acq=%l_pong_write, rel=%l_pong_read }
    } : (memref<16x256xf32, "SHARED">, memref<16x256xf32, "SHARED">) -> ()

    // ============================================================
    // 5. [Compute Loop] 执行 Ping-Pong 计算
    // ============================================================
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    
    scf.for %i = %c0 to %loop_count step %c1 {
      
      // --- A. Ping/Pong 选择逻辑 ---
      // 偶数轮用 Ping，奇数轮用 Pong
      %is_ping = arith.cmpi "eq", arith.remui(%i, %c2), %c0 : index
      
      // 使用 scf.if 选择当前的 Buffer 和 Lock
      %curr_buf, %curr_read_lock, %curr_write_lock = scf.if %is_ping 
        -> (memref<16x256xf32, "SHARED">, !dskernel.lock, !dskernel.lock) {
        scf.yield %ping, %l_ping_read, %l_ping_write
      } else {
        scf.yield %pong, %l_pong_read, %l_pong_write
      }

      // --- B. Acquire (等待数据) ---
      // 等待 DMA 填满数据 (Read Lock -> 1)
      "dskernel.acquire_lock"(%curr_read_lock, 1)

      // --- C. Compute (核心计算) ---
      // 在这里，tensor 的概念已经消失了，我们直接操作物理 memref
      "core.compute"(%curr_buf) : (memref<16x256xf32, "SHARED">) -> ()

      // --- D. Release (释放缓冲) ---
      // 归还 Buffer 给 DMA (Write Lock -> 1)
      "dskernel.release_lock"(%curr_write_lock, 1)
    }
  
    return
  }
}